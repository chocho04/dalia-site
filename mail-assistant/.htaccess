# Конфигурацията, cron скриптът и документацията не са за уеб достъп.
<FilesMatch "^(config\.php|config\.sample\.php|cron\.php|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# HTML/JS/CSS винаги се проверяват отново, за да важи обновяването веднага.
<IfModule mod_headers.c>
    <FilesMatch "\.(php|js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
